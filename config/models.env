# Which model each cheap tier uses. One line to change — no code.
# Read by bin/oc-ask (and anything else that sources ~/.agents/models.env).
#
# Format: provider/model as listed by `opencode models`.
# Examples (check the exact IDs on your machine):
#   CHEAP_MODEL=opencode-go/deepseek-v4-pro
#   CHEAP_MODEL=opencode-go/glm-5.3
#   CHEAP_MODEL=ollama/qwen3-coder        # local, needs an `ollama` provider in opencode.json
#
# Empty = let OpenCode use its own default model.
CHEAP_MODEL=

# Seconds before oc-ask gives up and lets Claude fall back to its own agents.
OC_ASK_TIMEOUT=300
