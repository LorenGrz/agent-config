{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Generated by build.sh from this hub's canonical sources (config/AGENTS.md,
  // config/rules/*.md, selected skills). Run `install.sh --with-rulesync` or
  // `build.sh && pnpm dlx rulesync generate -g --targets codexcli,geminicli,cursor`
  // directly from this directory.
  "targets": ["codexcli", "antigravity-cli", "cursor"],
  "features": ["rules", "skills"],
  "outputRoots": ["."],
  "delete": false,
  "verbose": false,
  "silent": false,
  "global": true,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "gitignoreTargetsOnly": true
}
